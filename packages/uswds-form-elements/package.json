{
  "name": "uswds-form-elements",
  "version": "0.1.0",
  "description": "Small Lit-based Web Components that emit U.S. Web Design System form markup.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./define": {
      "types": "./dist/define.d.ts",
      "import": "./dist/define.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@uswds/uswds": "3.13.0"
  },
  "peerDependencies": {
    "@uswds/uswds": ">=3 <4"
  },
  "peerDependenciesMeta": {
    "@uswds/uswds": {
      "optional": true
    }
  }
}
