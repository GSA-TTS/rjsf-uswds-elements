{
  "name": "rjsf-uswds",
  "version": "0.1.0",
  "description": "A U.S. Web Design System (USWDS) theme for React JSON Schema Form (RJSF), backed by small USWDS Web Components.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "src/styles.css"
  ],
  "sideEffects": [
    "*.css",
    "uswds-form-elements"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "uswds-form-elements": "0.1.0"
  },
  "peerDependencies": {
    "@rjsf/core": ">=6 <7",
    "@rjsf/utils": ">=6 <7",
    "react": ">=19 <20"
  },
  "devDependencies": {
    "@rjsf/core": "6.10.0",
    "@rjsf/utils": "6.10.0",
    "@rjsf/validator-ajv8": "6.10.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  }
}
